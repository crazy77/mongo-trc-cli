{
  "name": "mongo-trc-cli",
  "version": "0.1.3",
  "description": "A CLI tool for scaffolding Mongoose models and tRPC API routes based on Zod schemas",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mongo-trc": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazy77/mongo-trc-cli.git"
  },
  "keywords": [
    "cli",
    "mongoose",
    "zod",
    "trpc",
    "generator",
    "scaffold",
    "typescript"
  ],
  "author": "fanta <crazy77f@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/crazy77/mongo-trc-cli/issues"
  },
  "homepage": "https://github.com/crazy77/mongo-trc-cli#readme",
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "@zodyac/zod-mongoose": "^3.2.0",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "fs-extra": "^11.3.0",
    "mongoose": "^8.13.2",
    "ora": "^8.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
