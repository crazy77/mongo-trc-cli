import { z } from 'zod';
import { createTRPCRouter, protectedProcedure, publicProcedure } from '%%RELATIVE_PATH_TO_TRPC%%';
import { getMany } from '%%RELATIVE_PATH_TO_UTIL%%'; 
import {
  collections,
  deleteSchema,
  getManySchema,
  getOneSchema,
  %%PASCAL_CASE_SCHEMA_NAME%%CreateSchema,
  %%PASCAL_CASE_SCHEMA_NAME%%UpdateSchema,
} from '%%RELATIVE_PATH_TO_DERIVED%%';
import type { %%PASCAL_CASE_SCHEMA_NAME%% } from '%%RELATIVE_PATH_TO_DERIVED%%';

export const %%SCHEMA_NAME%%Router = createTRPCRouter({
  getMany: publicProcedure.input(getManySchema).query(async ({ input, ctx }) => {
    const res = await getMany<%%PASCAL_CASE_SCHEMA_NAME%%>(collections.%%SCHEMA_NAME%%, input);
    return res;
  }),
  getOne: publicProcedure.input(getOneSchema).query(async ({ input, ctx }) => {
    const res = await collections.%%SCHEMA_NAME%%
      .findOne({ _id: input._id })
      .select(input.select ?? [])
      .populate(input.populate ?? [])
      .lean()
      .exec();
    return res as %%PASCAL_CASE_SCHEMA_NAME%% | null;
  }),
  create: protectedProcedure.input(%%PASCAL_CASE_SCHEMA_NAME%%CreateSchema).mutation(async ({ input, ctx }) => {
    const res = await collections.%%SCHEMA_NAME%%.create(input);
    return res.toObject() as %%PASCAL_CASE_SCHEMA_NAME%%; 
  }),
  update: protectedProcedure.input(%%PASCAL_CASE_SCHEMA_NAME%%UpdateSchema.extend({ _id: z.string() })).mutation(async ({ input, ctx }) => {
    const { _id, ...updateData } = input;
    const res = await collections.%%SCHEMA_NAME%%.findByIdAndUpdate(_id, updateData, { new: true }).lean();
    return res as %%PASCAL_CASE_SCHEMA_NAME%% | null;
  }),
  delete: protectedProcedure.input(deleteSchema).mutation(async ({ input, ctx }) => {
    const res = await collections.%%SCHEMA_NAME%%.deleteOne({ _id: input._id }).exec();
    return res;
  }),
});

